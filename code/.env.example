# Copier ce fichier en .env et compléter. Ne jamais versionner le fichier .env.
ANTHROPIC_API_KEY=
GMAIL_ADRESSE=contact@rodolphethienard.fr
# Mot de passe d'application Gmail (16 lettres), pas le mot de passe du compte
GMAIL_APP_PASSWORD=
GMAIL_DOSSIER=INBOX
# JIRA Cloud (facultatif) : adresse du site, compte et jeton API
# Jeton à créer sur https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://votre-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=created >= -30d ORDER BY created DESC
